'use client';

import React, { useState } from 'react';
import Image from 'next/image';
import { ThemeProvider } from 'styled-components';
import { theme } from '../styles/theme';
import {
  Main,
  Hero,
  ContentWrapper,
  Name,
  Title,
  Description,
  ProfileImage,
  ScrollIndicator,
  BackgroundText,
  Footer
} from '../styles/HomeStyles';
import {
  Section,
  SectionTitle,
  ExperienceGrid,
  ExperienceCard,
  SkillsGrid,
  SkillCard,
  EducationList,
  EducationItem,
  ContactSection
} from '../styles/SectionStyles';
import { FaLinkedin, FaEnvelope } from 'react-icons/fa';

export default function Home() {
  const [formData, setFormData] = useState({
    firstName: '',
    lastName: '',
    email: '',
    message: ''
  });
  
  const [formSubmitted, setFormSubmitted] = useState(false);
  
  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { id, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [id]: value
    }));
  };
  
  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    console.log('Form submitted:', formData);
    setFormSubmitted(true);
    setTimeout(() => {
      setFormData({
        firstName: '',
        lastName: '',
        email: '',
        message: ''
      });
      setFormSubmitted(false);
    }, 3000);
  };

  const scrollToContent = () => {
    window.scrollTo({
      top: window.innerHeight,
      behavior: 'smooth'
    });
  };

  return (
    <ThemeProvider theme={theme}>
      <Main>
        <Hero>
          <BackgroundText>
            <span>BE CREATIVE</span>
            <span>DESIGN SOLUTIONS</span>
            <span>BUILD IMPACT</span>
          </BackgroundText>
          <ContentWrapper>
            <Name>SOPHIA REYNOLDS, MBA, MFA</Name>
            <Title>Creating Designs. Creating Solutions. Bringing Ideas to Life. Building Connections. Inspiring Innovation.</Title>
            <Description>
              Passionate about developing intuitive user experiences and facilitating meaningful 
              connections through creative design and technological innovation.
            </Description>
          </ContentWrapper>
          <ProfileImage>
            <Image
              src="/profile.jpg"
              alt="Sophia Reynolds"
              fill
              style={{ objectFit: 'cover' }}
              priority
              sizes="(max-width: 768px) 100vw, 400px"
            />
          </ProfileImage>
          <ScrollIndicator onClick={scrollToContent}>
            Scroll Down
          </ScrollIndicator>
        </Hero>

        <Section>
          <SectionTitle>Experience</SectionTitle>
          <ExperienceGrid>
            <ExperienceCard>
              <h3>Senior UX Designer</h3>
              <h4>Digital Innovation Lab, Stanford University</h4>
              <p>Leading the user experience design for educational technology initiatives through collaborative design, 
              student feedback incorporation, and interface optimization. Providing essential guidance for development 
              teams in the innovation ecosystem.</p>
              <div className="date">2020 - Present</div>
            </ExperienceCard>
            <ExperienceCard>
              <h3>Product Design Specialist</h3>
              <h4>TechVision</h4>
              <p>Delivered exceptional product design solutions, ensuring intuitive user interfaces and 
              effective user journeys while maintaining design system consistency and 
              following industry best practices.</p>
              <div className="date">2018 - 2020</div>
            </ExperienceCard>
            <ExperienceCard>
              <h3>Creative Technology Coordinator</h3>
              <h4>San Francisco Digital Arts Commission (SFDAC)</h4>
              <p>Facilitated creative technology initiatives and design workshops to strengthen 
              community-technology relationships. Organized public exhibitions and developed visual communication 
              strategies to engage diverse audiences.</p>
              <div className="date">2016 - 2018</div>
            </ExperienceCard>
          </ExperienceGrid>
        </Section>

        <Section $dark={true}>
          <SectionTitle $dark={true}>Skills</SectionTitle>
          <SkillsGrid>
            <SkillCard $dark={true}>
              <h3>Design & Creativity</h3>
              <ul>
                <li>UX/UI Design</li>
                <li>Design Thinking</li>
                <li>Visual Communication</li>
                <li>Creative Problem Solving</li>
                <li>Interactive Prototyping</li>
              </ul>
            </SkillCard>
            <SkillCard $dark={true}>
              <h3>Technical & Management</h3>
              <ul>
                <li>Product Development</li>
                <li>Design Systems</li>
                <li>User Research</li>
                <li>Agile Methodology</li>
                <li>Project Management</li>
              </ul>
            </SkillCard>
            <SkillCard $dark={true}>
              <h3>Innovation & Impact</h3>
              <ul>
                <li>Digital Transformation</li>
                <li>Accessibility & Inclusion</li>
                <li>Creative Direction</li>
                <li>Human-Centered Design</li>
                <li>Design Leadership</li>
              </ul>
            </SkillCard>
          </SkillsGrid>
        </Section>

        <Section>
          <SectionTitle>Education</SectionTitle>
          <EducationList>
            <EducationItem>
              <h3>Stanford University</h3>
              <h4>Master of Fine Arts (MFA)</h4>
              <p>School of Art & Design, Concentration in Digital Media</p>
              <div className="date">2016</div>
            </EducationItem>
            <EducationItem>
              <h3>University of California, Berkeley</h3>
              <h4>Master of Business Administration (MBA)</h4>
              <p>Haas School of Business, Focus on Design Innovation</p>
              <div className="date">2014</div>
            </EducationItem>
            <EducationItem>
              <h3>University of San Francisco</h3>
              <h4>B.A. Interactive Media Design</h4>
              <p>Focus on human-computer interaction and digital communication</p>
              <div className="date">2010</div>
            </EducationItem>
          </EducationList>
        </Section>

        <Section $dark={true}>
          <SectionTitle $dark={true}>Contact</SectionTitle>
          <ContactSection $dark={true}>
            <Description className="contact-description">
              I'm passionate about creating innovative digital experiences and fostering positive change 
              through design and technological solutions. Let's connect!
            </Description>
            
            <div className="contact-container">
              <div className="contact-form">
                {formSubmitted ? (
                  <div className="success-message">
                    <h3>Thank you for your message!</h3>
                    <p>I'll get back to you as soon as possible.</p>
                  </div>
                ) : (
                  <form onSubmit={handleSubmit}>
                    <div className="form-group">
                      <label htmlFor="firstName">First Name *</label>
                      <input 
                        type="text" 
                        id="firstName" 
                        value={formData.firstName}
                        onChange={handleInputChange}
                        required 
                      />
                    </div>
                    
                    <div className="form-group">
                      <label htmlFor="lastName">Last Name *</label>
                      <input 
                        type="text" 
                        id="lastName" 
                        value={formData.lastName}
                        onChange={handleInputChange}
                        required 
                      />
                    </div>
                    
                    <div className="form-group">
                      <label htmlFor="email">Email *</label>
                      <input 
                        type="email" 
                        id="email" 
                        value={formData.email}
                        onChange={handleInputChange}
                        required 
                      />
                    </div>
                    
                    <div className="form-group">
                      <label htmlFor="message">Type your message here... *</label>
                      <textarea 
                        id="message" 
                        rows={5} 
                        value={formData.message}
                        onChange={handleInputChange}
                        required
                      ></textarea>
                    </div>
                    
                    <button type="submit" className="submit-btn">Submit</button>
                  </form>
                )}
              </div>
              
              <div className="contact-info">
                <h3>SOPHIA REYNOLDS</h3>
                <p className="contact-role">UX DESIGNER & CREATIVE TECHNOLOGIST</p>
                
                <div className="contact-detail">
                  <span>Phone:</span>
                  <p>415-555-8765</p>
                </div>
                
                <div className="contact-detail">
                  <span>Email:</span>
                  <p>contact@sophiareynolds.com</p>
                </div>
                
                <hr className="divider" />
                
                <div className="social-links">
                  <a href="https://www.linkedin.com/in/sophia/" target="_blank" rel="noopener noreferrer">
                    <FaLinkedin />
                  </a>
                  <a href="mailto:contact@sophiareynolds.com">
                    <FaEnvelope />
                  </a>
                </div>
              </div>
            </div>
          </ContactSection>
        </Section>
        
        <Footer>
          © 2025 By Sophia Reynolds. Made with Creativity and Code by <a href="https://www.nelsonfoster.com" target="_blank" rel="noopener noreferrer">Nelson Foster</a>
        </Footer>
      </Main>
    </ThemeProvider>
  );
}
